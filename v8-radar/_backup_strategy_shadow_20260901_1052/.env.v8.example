# V8 Research Shadow：默认不推送、不自动交易
V8_ENABLE=true
V8_SHADOW_ONLY=true
V8_PUSH_ENABLED=false
V8_AUTO_ORDER_ENABLED=false
V8_DB_PATH=data_v8/signal_lab_v8.sqlite3
V8_WEBHOOK_FILE=wework_webhook_v8_shadow.txt
V8_MAX_PAID_CALLS_PER_MINUTE=60
V8_PAID_RESERVE_CRITICAL=10
V8_PAID_RESERVE_CHECKPOINT=10
V8_PAID_RESERVE_NORMAL=8
V8_MAX_ENRICHED_CANDIDATES=8
V8_HOLDING_SCAN_SECONDS=60
V8_FORWARD_COST_BPS=20
V8_SCAN_OFFSET_SECONDS=8
V8_PERSISTENCE_CHECK_MINUTES=3,6,10
V8_MIN_PERSISTENCE_ROUNDS=2
V8_ENTRY_MIN_MARKET_SCORE=48
V8_ENTRY_MIN_SECTOR_SCORE=62
V8_ENTRY_MIN_SECTOR_UP_RATIO=0.52
V8_ENTRY_MAX_PCT_CHG=4.0
V8_ENTRY_MAX_VWAP_DISTANCE_PCT=1.5
V8_ENTRY_PULLBACK_MIN_DROP_PCT=0.35
V8_ENTRY_ZONE_FLOOR_PCT=0.5
V8_MAX_NEW_POSITIONS_PER_DAY=2
V8_MAX_SINGLE_POSITION_PCT=10
V8_MAX_SECTOR_EXPOSURE_PCT=25
V8_RISK_PER_TRADE_PCT=0.6
V8_MAX_TOTAL_EXPOSURE_ATTACK_PCT=60
V8_MAX_TOTAL_EXPOSURE_NORMAL_PCT=40
V8_MAX_TOTAL_EXPOSURE_DEFENSE_PCT=15
V8_DAILY_LOSS_LIMIT_PCT=2
V8_PORTFOLIO_DRAWDOWN_LIMIT_PCT=8

# 一个月付费接口归档：盘中不抢关键额度，盘后断点保存
V8_PAID_ARCHIVE_ENABLE=true
V8_PAID_ARCHIVE_DB_PATH=D:\A股机会雷达_V8_数据仓库\paid_archive_v8.sqlite3
V8_PAID_ARCHIVE_WORKER_SECONDS=8
V8_PAID_ARCHIVE_TARGET_N=30
V8_PAID_ARCHIVE_CHIP_TARGET_N=12
V8_PAID_ARCHIVE_DAILY_DAYS=1825
V8_PAID_ARCHIVE_BASIC_DAYS=730
V8_PAID_ARCHIVE_MONEYFLOW_DAYS=365
V8_PAID_ARCHIVE_MIN_FREE_GB=20
V8_PAID_ARCHIVE_MAX_DB_GB=25

# V8副本内兼容已验证的V7.2付费解析器；不要填写到公开压缩包
# 默认只读当前V7.2的TUSHARE_TOKEN/TUSHARE_HTTP_URL；也可指定其他私密配置来源
V8_PAID_CREDENTIAL_SOURCE=E:\A股机会雷达_V7.2_Research_Shadow_融合运行版\.env.v7
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://tt.dailyfetch.top/
V7_SHADOW_ENABLED=false
V7_TUSHARE_ENABLED=true
V7_PAID_PROVIDER_ENABLED=true
V7_API_LIMIT_PER_MINUTE=30
V71_PUSH_ENABLED=false
V71_UNIFIED_MODE=false
V71_ROUTE_V66_MESSAGES=false
V66_ORIGINAL_PUSH_ENABLED=false
V72_PORTFOLIO_PUSH=false
V72_CATALYST_PUSH=false
V72_REALTIME_AUCTION_TICK_ENABLED=true
